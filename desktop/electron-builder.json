{
  "appId": "com.simplebilling.suite",
  "productName": "Simple Billing Suite",
  "copyright": "Copyright © 2026 Simple Billing Team",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "src-electron/**/*",
    "package.json"
  ],
  "win": {
    "signAndEditExecutable": false,
    "target": [
      {
        "target": "dir",
        "arch": ["x64"]
      }
    ],
    "artifactName": "SimpleBilling-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Simple Billing Suite"
  }
}
